{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "resume-ai",
  "mainBinaryName": "resume-ai-desktop",
  "identifier": "dev.resume-ai.desktop",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "npm run vendor",
    "beforeBuildCommand": "npm run vendor"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Resume AI",
        "width": 1400,
        "height": 860,
        "minWidth": 800,
        "minHeight": 500,
        "backgroundColor": "#1a1a1a",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "List and resume your AI coding-agent sessions",
    "longDescription": "Resume AI lists every session of Claude Code, Codex, Gemini, opencode, Copilot and Cursor on your machine and resumes any of them in a tab.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
