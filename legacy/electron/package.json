{
  "name": "agent-sessions",
  "productName": "Agent Sessions",
  "version": "1.0.0",
  "description": "UI mínima para listar y retomar sesiones de agentes de IA (Claude Code, Codex, Gemini, opencode, Copilot, Cursor) en Windows",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "dev.local.agent-sessions",
    "productName": "Agent Sessions",
    "files": [
      "main.js",
      "preload.js",
      "core/**",
      "renderer/**",
      "node_modules/**"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "engines": {
    "node": ">=22.13"
  }
}